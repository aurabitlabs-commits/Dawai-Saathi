# Supabase: create a project, run supabase-schema.sql in SQL Editor, then copy Project URL and anon/public key.
# Never place the service_role key in a browser app.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Gemini integration (optional, depending on enabled app features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
