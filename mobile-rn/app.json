{
  "expo": {
    "name": "SehatParivaar",
    "slug": "sehat-parivaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.sehatparivaar.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SehatParivaar to choose a medicine reference photo stored on this phone.",
          "cameraPermission": "Allow SehatParivaar to take a medicine reference photo stored on this phone."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "offlineOnly": true,
      "eas": {
        "projectId": "57bce990-1218-4420-8723-fa25c865fa4a"
      }
    }
  }
}
