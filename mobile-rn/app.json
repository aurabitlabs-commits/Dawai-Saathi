{
  "expo": {
    "name": "SehatParivaar",
    "slug": "sehat-parivaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.sehatparivaar.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SehatParivaar to choose a medicine reference photo stored on this phone.",
          "cameraPermission": "Allow SehatParivaar to take a medicine reference photo stored on this phone."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "offlineOnly": true
    }
  }
}
